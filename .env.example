# Django
DJANGO_SECRET_KEY=generate-with-django.core.management.utils.get_random_secret_key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=pam-lifecycle.internal.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://pam-lifecycle.internal.example.com
DISPLAY_TIME_ZONE=America/New_York

# Database
DATABASE_NAME=pamsiem
DATABASE_USER=pamsiem
DATABASE_PASSWORD=
DATABASE_HOST=postgres.internal.example.com
DATABASE_SSLMODE=verify-full

# Broker
CELERY_BROKER_URL=redis://redis.internal.example.com:6379/0

# Internal certificate authority bundle used for every outbound call.
# Point this at the enterprise bundle rather than disabling verification.
PAM_CA_BUNDLE=/etc/ssl/certs/enterprise-ca.pem

# Collector identities. Each holds a JSON object and is referenced from the
# PamSystem row as env:NAME. Nothing is stored in the database.
PAM_CYBERARK_PROD={"username":"svc_pam_reader","password":"..."}
PAM_DELINEA_PROD={"username":"svc_pam_reader","password":"..."}
PAM_BEYONDTRUST_PROD={"api_key":"...","run_as_user":"svc_pam_reader","run_as_password":"..."}
PAM_VAULT_PROD={"role_id":"...","secret_id":"..."}

# Downstream forwarding
SPLUNK_HEC_URL=https://splunk-hec.internal.example.com:8088/services/collector/event
SPLUNK_HEC_TOKEN_REFERENCE=env:SPLUNK_HEC_TOKEN
SPLUNK_HEC_TOKEN={"token":"..."}
SPLUNK_HEC_INDEX=pam_lifecycle
